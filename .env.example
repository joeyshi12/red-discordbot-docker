# Required for initial bot setup
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_OWNER_ID=your_discord_user_id_here

# Optional
DISCORD_BOT_PREFIX=!
TZ=UTC

# Optional Redbot package version specifier (leave empty for latest)
# Examples: ==3.5.24 or ~=3.5.0
REDBOT_VERSION=

# Optional additional startup flags passed to redbot
# Example: --no-cogs --debug
EXTRA_ARGS=
